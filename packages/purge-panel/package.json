{
  "name": "dsh-purge-panel",
  "version": "1.1.2",
  "description": "Purge UI: 독립된 오른쪽 진입점과 네이티브 스타일 설정 페이지. 공식 Purge 는 따로 업데이트할 수 있다.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"scripts/*.mjs\" \"test/*.{cjs,mjs}\"",
    "test": "npm run check:build && node --check client.js && node test/check.cjs && node test/requests.cjs && node test/rewind.mjs && node test/session-context.mjs && node test/api.mjs && node --test test/maintenance.test.cjs test/restart.test.cjs test/welcome.test.cjs test/layout-notice.test.cjs test/apply-result.test.cjs test/status.test.cjs",
    "prepack": "npm run check:build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wnduddld0513/dsh-purge-kr.git",
    "directory": "packages/purge-panel"
  }
}
